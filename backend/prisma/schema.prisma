// SEEDS Digital Platform — data model (FEAT-001)
// SQLite for local dev/tests today; switch `provider` to "postgresql" (and `url` to
// env("DATABASE_URL") pointed at a real Postgres instance) before any staging/production deploy.
// Schema is written provider-agnostic where Prisma allows — no SQLite-only column types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTS
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

// --- Identity -----------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  // Either an email or a GR (registration) number — the login screen accepts either;
  // the auth service decides which format was typed, this column just stores whichever
  // the account was created with, uniquely.
  identifier   String   @unique
  passwordHash String
  role         Role
  isLocked     Boolean  @default(false)
  lockedUntil  DateTime?
  failedLoginCount Int  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentProfile ParentProfile?
  teacher       Teacher?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  deviceTokens  DeviceToken[]
  sentMessages     Message[]         @relation("MessageSender")
  circularsCreated Circular[]        @relation("CircularAuthor")

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- School structure -----------------------------------------------------

model School {
  id        String    @id @default(uuid())
  name      String
  campuses  Campus[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Campus {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  classes   Class[]
  students  Student[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model AcademicSession {
  id         String   @id @default(uuid())
  label      String   // e.g. "2026-2027"
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(false)
  classes    Class[]
  feeVouchers FeeVoucher[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Class {
  id                String   @id @default(uuid())
  campusId          String
  campus            Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name              String   // e.g. "Grade 3"
  sections          Section[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([campusId])
  @@index([academicSessionId])
}

model Section {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String   // e.g. "3A"
  students  Student[]
  timetables Timetable[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  timetables Timetable[]
  diaryEntries DiaryEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  timetables    Timetable[]
  attendanceMarks Attendance[] @relation("AttendanceMarkedBy")
  diaryEntries    DiaryEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Students & parents -----------------------------------------------------

model Student {
  id         String   @id @default(uuid())
  campusId   String
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  grNumber   String   @unique
  name       String
  parents         StudentParent[]
  attendance      Attendance[]
  diaryReads      DiaryEntry[]     @relation("DiaryEntryStudents")
  feeVouchers     FeeVoucher[]
  leaveRequests   LeaveRequest[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campusId])
  @@index([sectionId])
}

model ParentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  children  StudentParent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table — a parent may be linked to many students, a student may have many parents/guardians.
model StudentParent {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentProfileId String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  relationship    String        @default("guardian") // e.g. "mother", "father", "guardian"
  createdAt       DateTime      @default(now())

  @@unique([studentId, parentProfileId])
  @@index([parentProfileId])
  @@index([studentId])
}

// --- Sprint 2+ feature tables (kept in the schema now so FEAT-001 doesn't need a
// second migration pass later; not read/written by any endpoint built in this run) ---

model Timetable {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  dayOfWeek Int      // 0=Sunday..6=Saturday
  period    Int
  startTime String   // "08:00"
  endTime   String   // "08:40"
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

model Attendance {
  id           String           @id @default(uuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  status       AttendanceStatus
  markedById   String
  markedBy     Teacher          @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
}

model DiaryEntry {
  id         String    @id @default(uuid())
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  students   Student[] @relation("DiaryEntryStudents")
  date       DateTime
  text       String
  dueDate    DateTime?
  attachments DiaryAttachment[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model DiaryAttachment {
  id           String     @id @default(uuid())
  diaryEntryId String
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  fileId       String
  file         File       @relation(fields: [fileId], references: [id])
  createdAt    DateTime   @default(now())
}

model Circular {
  id          String   @id @default(uuid())
  title       String
  description String
  scope       String   // "school" | "section"
  priority    String   @default("normal")
  authorId    String
  author      User     @relation("CircularAuthor", fields: [authorId], references: [id])
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  attachments CircularAttachment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CircularAttachment {
  id         String   @id @default(uuid())
  circularId String
  circular   Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id])
  createdAt  DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  subject    String
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  recipients MessageRecipient[]
  createdAt  DateTime @default(now())
}

model MessageRecipient {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  entityRef String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model FeeStructure {
  id        String   @id @default(uuid())
  name      String
  amount    Int      // in smallest currency unit (paisa) — never a float
  createdAt DateTime @default(now())
}

model FeeVoucher {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  month             String   // "2026-09"
  issueDate         DateTime
  dueDate           DateTime
  items             FeeItem[]
  payments          FeePayment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
}

model FeeItem {
  id           String     @id @default(uuid())
  feeVoucherId String
  feeVoucher   FeeVoucher @relation(fields: [feeVoucherId], references: [id], onDelete: Cascade)
  label        String
  amount       Int        // paisa
}

model FeePayment {
  id           String     @id @default(uuid())
  feeVoucherId String
  feeVoucher   FeeVoucher @relation(fields: [feeVoucherId], references: [id], onDelete: Cascade)
  amount       Int
  method       String     // "jazzcash" | "easypaisa" | "manual"
  status       String     // "pending" | "completed" | "failed"
  receipt      Receipt?
  createdAt    DateTime   @default(now())
}

model Receipt {
  id           String     @id @default(uuid())
  feePaymentId String     @unique
  feePayment   FeePayment @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  receiptNumber String    @unique
  createdAt    DateTime   @default(now())
}

model LeaveRequest {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id           String   @id @default(uuid())
  storageKey   String   @unique // randomized name in the S3-compatible bucket, not the original filename
  originalName String
  mimeType     String
  sizeBytes    Int
  diaryAttachments    DiaryAttachment[]
  circularAttachments CircularAttachment[]
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "login" | "attendance.update" | "circular.publish" | ...
  entity    String
  entityId  String?
  metadata  String?  // JSON-encoded, never passwords/tokens
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())

  @@index([userId])
}
